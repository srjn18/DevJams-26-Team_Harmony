# ============================================================
# LLM Context Optimization Middleware — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.
#
# OpenAI is the locked provider (no multi-provider support — design.md §13).
# ============================================================

# --- LLM Provider ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini              # e.g. gpt-4o, gpt-4o-mini, gpt-4-turbo

# --- OpenAI ---
OPENAI_API_KEY=sk-...your-key-here...

# --- Routing thresholds ---
ROUTING_LIGHT_MIN_SAVINGS=0.000001   # set to 0.0 to always optimize
ROUTING_FULL_THRESHOLD=0.00001
ROUTING_ESTIMATED_REDUCTION_FRACTION=0.50

# --- Token budget default ---
DEFAULT_TOKEN_BUDGET=4096

# --- LLM call settings ---
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60

# --- Judge model (LLM-as-judge evaluation) ---
JUDGE_MODEL=gpt-4o-mini
